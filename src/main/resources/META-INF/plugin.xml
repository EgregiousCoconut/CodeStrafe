<idea-plugin>
    <id>com.codestrafe</id>
    <name>CodeStrafe</name>
    <vendor>CodeStrafe</vendor>

    <description><![CDATA[
        CodeStrafe is a JetBrains IDE plugin for one-handed, keyboard-only code navigation.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.codestrafe.CodeStrafeStartupActivity"/>

        <notificationGroup
                id="CodeStrafe Notifications"
                displayType="BALLOON"/>
    </extensions>

    <actions>
        <action
                id="CodeStrafe.ToggleMode"
                class="com.codestrafe.ToggleCodeStrafeModeAction"
                text="Toggle CodeStrafe Mode"
                description="Toggle CodeStrafe navigation mode"/>

        <action
                id="CodeStrafe.DebugState"
                class="com.codestrafe.DebugCodeStrafeStateAction"
                text="Debug CodeStrafe State"
                description="Print CodeStrafe debug state"/>

        <action
                id="CodeStrafe.ToggleVoice"
                class="com.codestrafe.ToggleCodeStrafeVoiceAction"
                text="Toggle CodeStrafe Voice"
                description="Start or stop Google Speech-to-Text and Llama voice command recognition"/>
    </actions>
</idea-plugin>